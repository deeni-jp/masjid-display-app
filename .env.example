# Masjid configuration. Copy this file to .env and fill in your values.
# Everything that differs from one masjid to another is set here.
#
# IMPORTANT: .env is bundled INTO the app. On the web it can be downloaded by
# anyone, and it can be extracted from any APK/IPA. Only put PUBLIC settings
# here — never keys, passwords or service-account credentials.
# (The Firebase service-account key lives in the push worker as a Cloudflare
# secret — see push-worker/README.md.)
#
# After changing MASJID_NAME, MASJID_SHORT_NAME or APP_ID, run
#   dart run tool/apply_branding.dart
# to copy them into the Android, iOS, web and Windows project files.

# --- Masjid ------------------------------------------------------------------
# Full name, shown in the app and on the display.
MASJID_NAME=Masjid Prayer Times
# Short name (12 characters or fewer) under the app icon on phones.
MASJID_SHORT_NAME=Masjid

# App ID on Android (Google Play) and bundle ID on iOS, e.g. org.yourmasjid.app.
# Must be unique, use only letters, digits and dots, and must match the apps
# registered in Firebase. Never change it after publishing on Google Play.
APP_ID=com.example.masjidprayertimes

# Location used when the device location isn't available (normally the
# masjid's own location). Default: Makkah.
DEFAULT_LATITUDE=21.4225
DEFAULT_LONGITUDE=39.8262
DEFAULT_CITY=Makkah
DEFAULT_COUNTRY=Saudi Arabia

# --- Prayer-time calculation (Aladhan API) -----------------------------------
# Method: 0 Shia Ithna-Ashari, 1 Karachi, 2 ISNA, 3 Muslim World League,
# 4 Umm Al-Qura, 5 Egyptian (full list: https://aladhan.com/calculation-methods)
ALADHAN_API_METHOD=3

# Asr calculation: 0 = Shafi/standard (Shafi, Maliki, Hanbali), 1 = Hanafi
ALADHAN_SCHOOL=1

# --- Firebase (client config; public by design) --------------------------------
# Firebase Console -> Project settings -> Your apps. Values from the web app
# config, plus the app ID of each Android/iOS app you registered.
# (Alternatively run `flutterfire configure`, which writes
# lib/firebase_options.dart directly; these values are then not used.)
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
# API keys: one per platform in Firebase; the web key works everywhere if you
# leave the Android/iOS ones empty.
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
# App IDs, e.g. 1:1234567890:web:abc123
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# --- Optional ------------------------------------------------------------------
# Push notifications: URL of the deployed push worker (push-worker/).
# Shown by `npx wrangler deploy`, e.g. https://masjid-push.<account>.workers.dev
# Leave empty to disable sending pushes from the app.
PUSH_WORKER_URL=

# Firebase App Check on the web: reCAPTCHA v3 SITE key (public, not the secret
# key). Create it in Firebase Console -> App Check -> Web app. Leave empty to
# skip App Check on the web (see docs/deployment.md -> App Check).
APP_CHECK_WEB_SITE_KEY=
