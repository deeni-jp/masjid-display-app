rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    // Helper function to check if user is moderator
    function isModerator() {
      return request.auth != null && getUserRole() == 'moderator';
    }

    // Helper function to check if user is moderator or admin
    function isModeratorOrAdmin() {
      return request.auth != null && (getUserRole() == 'admin' || getUserRole() == 'moderator');
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own document; admins can read everyone's
      // (Users screen). Role checks in these rules use get(), which isn't
      // limited by this rule.
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Users can create their own document on sign-up, only as 'public'
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == 'public';

      // Users can update only their display name and last-login time
      // (not role, deleted, active, ...). Admins can update any user.
      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'lastLogin'])) ||
        isAdmin()
      );

      // Only admins can delete users (protects against unauthorized deletion)
      allow delete: if isAdmin();
    }

    // Notifications collection (root level)
    match /notifications/{notificationId} {
      // Anyone authenticated can read notifications
      allow read: if request.auth != null;

      // Only moderators and admins can create, update, or delete notifications
      allow create: if isModeratorOrAdmin();
      allow update: if isModeratorOrAdmin();
      allow delete: if isModeratorOrAdmin();
    }

    // Mosque collection - iqama times
    match /mosque/iqama {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }

    // Mosque collection - legacy single notification (kept for backward compatibility)
    match /mosque/notification {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }

    // Mosque data subcollection - notifications (legacy path, if still used)
    match /mosque/data/notifications/{notificationId} {
      allow read: if true;
      allow create: if isModeratorOrAdmin();
      allow update: if isModeratorOrAdmin();
      allow delete: if isModeratorOrAdmin();
    }

    // Images attached to notices (one per notice, same id as the notice)
    match /mosque/data/notification_images/{notificationId} {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }

    // Mosque collection - other documents (fallback)
    match /mosque/{document} {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }

    // Deletion logs collection - audit trail for deleted users
    match /deletion_logs/{logId} {
      // Only admins can read deletion logs (audit access)
      allow read: if isAdmin();

      // Only admins can permanently delete logs (for test user cleanup)
      allow delete: if isAdmin();

      // Any authenticated user can create logs (system creates during deletion)
      allow create: if request.auth != null;

      // Logs should never be updated (audit integrity)
      allow update: if false;
    }
  }
}
